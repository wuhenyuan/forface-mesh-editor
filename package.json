{
  "name": "forface-mesh-editor",
  "version": "1.0.0",
  "description": "Vue 2 + Vite 项目",
  "main": "dist/forface-mesh-editor.umd.js",
  "module": "dist/forface-mesh-editor.es.js",
  "style": "dist/style.css",
  "types": "dist/main.d.ts",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/forface-mesh-editor.es.js",
      "require": "./dist/forface-mesh-editor.umd.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "jszip": "^3.10.1",
    "mitt": "^3.0.1",
    "three-bvh-csg": "^0.0.17",
    "three-mesh-bvh": "^0.9.4"
  },
  "peerDependencies": {
    "three": "^0.160.0",
    "element-ui": "^2.15.14",
    "lodash": "^4.17.21",
    "vue": "^2.7.16"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.26.0",
    "@typescript-eslint/parser": "^8.26.0",
    "@types/node": "^25.0.3",
    "@types/three": "^0.182.0",
    "element-ui": "^2.15.14",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-vue": "^9.23.0",
    "lodash": "^4.17.21",
    "prettier": "^3.2.5",
    "typescript": "^5.9.3",
    "vite": "^4.5.3",
    "vite-plugin-vue2": "^2.0.3",
    "vue": "^2.7.16",
    "vue-eslint-parser": "^9.4.2",
    "vue-template-compiler": "^2.7.16",
    "vue-tsc": "^3.2.1"
  },
  "scripts": {
    "dev": "vite --config vite.dev.config.ts",
    "build": "vite build --config vite.config.ts",
    "build:lib": "vite build --mode lib --config vite.config.ts && npm run build:types",
    "build:types": "vue-tsc --project tsconfig.build.json",
    "build:examples": "",
    "eslint:fix": "eslint \"src/**/*.{js,ts,vue}\" \"config/**/*.{js,ts}\" --fix",
    "lint": "eslint \"src/**/*.{js,ts,vue}\" \"config/**/*.{js,ts}\"",
    "format": "prettier --write \"src/**/*.{js,ts,vue}\" \"config/**/*.{js,ts}\"",
    "dev:demo": "npm run build && cd examples/vite-vue2-demo && npm run dev",
    "prod:demo": "npm run build && cd examples/vite-vue2-demo && npm run build && npm run preview",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "vue",
    "vite",
    "mesh-editor"
  ],
  "author": "",
  "license": "ISC",
  "type": "module"
}
